{
  "name": "apptrack",
  "version": "1.0.0",
  "private": true,
  "description": "Track internship and job applications on a kanban board, with pipeline analytics.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "bench": "node scripts/bench.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.19.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autocannon": "8.0.0",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
